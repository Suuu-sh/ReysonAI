FROM node:22-alpine AS builder

WORKDIR /src
COPY apps/preflop-ui/package.json apps/preflop-ui/package-lock.json ./apps/preflop-ui/
RUN cd apps/preflop-ui && npm ci

COPY apps/preflop-ui ./apps/preflop-ui
COPY packages/solveagto-sdk-ts ./packages/solveagto-sdk-ts

RUN cd apps/preflop-ui && npm run build

FROM nginx:1.27-alpine

COPY deploy/kind/nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /src/apps/preflop-ui/dist/client /usr/share/nginx/html
