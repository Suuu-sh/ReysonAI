{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reysonai-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "api.reysonai.com/mcp", "zone_name": "reysonai.com" },
    { "pattern": "api.reysonai.com/oauth/mcp/*", "zone_name": "reysonai.com" },
    { "pattern": "api.reysonai.com/.well-known/oauth-authorization-server", "zone_name": "reysonai.com" },
    { "pattern": "api.reysonai.com/.well-known/oauth-protected-resource/mcp", "zone_name": "reysonai.com" }
  ],
  "vars": {
    "MCP_ENABLED": "false",
    "MCP_ACCESS_MODE": "authenticated_free",
    "MCP_ORIGIN": "https://api.reysonai.com",
    "MCP_ALLOWED_ORIGINS": "https://app.reysonai.com",
    "AUTH_ENABLED": "true",
    "AUTH_APP_URL": "https://app.reysonai.com"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "__REQUIRED_PRODUCTION_KV_NAMESPACE_ID__"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reysonai",
      "database_id": "5f3bd3a1-21c2-4367-9345-011990574b9d"
    }
  ]
}
