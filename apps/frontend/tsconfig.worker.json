{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": [],
    "lib": [
      "ES2022"
    ]
  },
  "include": [
    "../backend/src/**/*.ts",
    "../mcp/src/**/*.ts",
    "../mcp/worker-configuration.d.ts",
    "../mcp/node_modules/@cloudflare/workers-types/index.d.ts"
  ]
}
