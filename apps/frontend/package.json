{
  "name": "@reysonai/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-site-preview.ts && vite",
    "dev:codex": "node scripts/build-site-preview.ts && vite",
    "build": "node scripts/build-site-preview.ts && vite build && node scripts/prepare-sites-build.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.runtime.json && npm run typecheck:tooling",
    "lint": "biome lint src/site/ServiceSite.tsx src/site/content.ts src/site/content-ja.ts src/main.tsx src/ProductApp.tsx",
    "benchmark": "node scripts/benchmark-compare.ts",
    "benchmark:record": "node scripts/benchmark-record.ts",
    "open-ev": "node scripts/open-ev.ts",
    "exploit-open": "node scripts/exploit-open.ts",
    "audit:estimates": "node scripts/audit-estimates.ts",
    "build:estimates": "node scripts/build-estimates.ts",
    "build:estimates:aiv2": "node scripts/build-estimates.ts --aiv2",
    "pipeline": "node scripts/pipeline.ts",
    "range": "node scripts/range.ts",
    "raise-ev": "node scripts/raise-ev.ts",
    "eqr-sensitivity": "node scripts/eqr-sensitivity.ts",
    "postflop-ai:generate": "node scripts/postflop-ai/cli.ts generate",
    "postflop-ai:generate-later": "node scripts/postflop-ai/cli.ts generate-later",
    "postflop-ai:simulate": "node scripts/postflop-ai/cli.ts simulate",
    "postflop-ai:audit": "node scripts/postflop-ai/cli.ts audit",
    "postflop-ai:fix-overcall": "node scripts/postflop-ai/fix-overcall.ts",
    "postflop-ai:hand-ev": "node scripts/postflop-ai/cli.ts hand-ev",
    "postflop-ai:flop-base": "node scripts/postflop-ai/flop-base.ts",
    "publish:d1": "node scripts/publish-d1.ts",
    "postflop-ai:publish-d1": "node scripts/publish-d1.ts --only postflop",
    "postflop-ai:later-hand-ev": "node scripts/postflop-ai/cli.ts later-hand-ev",
    "postflop-ai:spots": "node scripts/postflop-ai/cli.ts spots",
    "test": "node --test --test-force-exit tests/*.test.ts",
    "test:sites": "node --test tests/sites-worker.test.ts",
    "dev:account": "node scripts/dev-account.ts",
    "dev:guest": "node scripts/build-site-preview.ts && VITE_DEV_GUEST=1 vite",
    "typecheck:tooling": "tsc --project tsconfig.scripts.json && tsc --project tsconfig.tests.json && tsc --project tsconfig.config.json && tsc --project tsconfig.qa.json",
    "typecheck:repository": "tsc --project ../../packages/reysonai-sdk-ts/tsconfig.json && npm run typecheck && tsc --project ../../tsconfig.tooling.json && tsc --project ../mcp/tsconfig.json"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "jsdom": "30.1.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
