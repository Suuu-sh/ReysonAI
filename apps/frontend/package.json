{
  "name": "@reysonai/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-site-preview.mjs && vite",
    "dev:codex": "node scripts/build-site-preview.mjs && vite",
    "build": "node scripts/build-site-preview.mjs && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.worker.json --noEmit && tsc --project tsconfig.runtime.json",
    "lint": "biome lint src/site/ServiceSite.tsx src/site/content.ts src/site/content-ja.ts src/main.tsx src/ProductApp.tsx",
    "benchmark": "node scripts/benchmark-compare.mjs",
    "benchmark:record": "node scripts/benchmark-record.mjs",
    "open-ev": "node scripts/open-ev.mjs",
    "exploit-open": "node scripts/exploit-open.mjs",
    "audit:estimates": "node scripts/audit-estimates.mjs",
    "build:estimates": "node scripts/build-estimates.mjs",
    "pipeline": "node scripts/pipeline.mjs",
    "range": "node scripts/range.mjs",
    "raise-ev": "node scripts/raise-ev.mjs",
    "eqr-sensitivity": "node scripts/eqr-sensitivity.mjs",
    "postflop-ai:generate": "node scripts/postflop-ai/cli.mjs generate",
    "postflop-ai:generate-later": "node scripts/postflop-ai/cli.mjs generate-later",
    "postflop-ai:simulate": "node scripts/postflop-ai/cli.mjs simulate",
    "postflop-ai:audit": "node scripts/postflop-ai/cli.mjs audit",
    "postflop-ai:fix-overcall": "node scripts/postflop-ai/fix-overcall.mjs",
    "postflop-ai:hand-ev": "node scripts/postflop-ai/cli.mjs hand-ev",
    "postflop-ai:flop-base": "node scripts/postflop-ai/flop-base.mjs",
    "publish:d1": "node scripts/publish-d1.mjs",
    "postflop-ai:publish-d1": "node scripts/publish-d1.mjs --only postflop",
    "postflop-ai:later-hand-ev": "node scripts/postflop-ai/cli.mjs later-hand-ev",
    "postflop-ai:spots": "node scripts/postflop-ai/cli.mjs spots",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "dev:account": "node scripts/dev-account.mjs",
    "dev:guest": "node scripts/build-site-preview.mjs && VITE_DEV_GUEST=1 vite"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.12",
    "jsdom": "30.1.1",
    "typescript": "^7.0.2"
  }
}
