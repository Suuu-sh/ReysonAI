{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strictNullChecks": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "tests/**/*.ts"
  ]
}
