{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reysonai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "routes": [{ "pattern": "api.reysonai.com", "custom_domain": true }],
  "r2_buckets": [
    {
      "binding": "SOLUTIONS",
      "bucket_name": "reysonai-solutions"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reysonai",
      "database_id": "5f3bd3a1-21c2-4367-9345-011990574b9d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated list of origins allowed by CORS.
    "ALLOWED_ORIGIN": "https://reysonai.com,https://reysonai.suuu-sh.workers.dev"
  }
}
