{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reysonai-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-22",
  "workers_dev": false,
  "durable_objects": {"bindings": [{"name": "FASTFOLD_RUNTIME", "class_name": "FastFoldRuntime"}]},
  "migrations": [{"tag": "fastfold-sqlite-v1", "new_sqlite_classes": ["FastFoldRuntime"]}],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "7361b0416fd648c0848b3692face14b5" }
  ],
  "routes": [{ "pattern": "api.reysonai.com", "custom_domain": true }],
  "r2_buckets": [
    {
      "binding": "SOLUTIONS",
      "bucket_name": "reysonai-solutions"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reysonai",
      "database_id": "5f3bd3a1-21c2-4367-9345-011990574b9d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated list of origins allowed by CORS.
    "ALLOWED_ORIGIN": "https://app.reysonai.com",
    // Google OAuth configured; live sign-in validation follows API deployment.
    "AUTH_ENABLED": "true",
    // Explicit authenticated jobs only; missing owner secret/heartbeat fails closed.
    "AIV2_ONDEMAND_ENABLED": "true",
    "AIV2_ONDEMAND_IMPLEMENTATION_HASH": "96e53c3932c656a1a331e8e2e389ff5e30e75eeb65db95eda07bdf3fb204e84d",
    "AIV2_ONDEMAND_SOURCE_HASH": "56e932510c9bb830422e62abc6dfdaf6b9dc0de97f11312dcbdeb48b12507a18",
    "AUTH_NATIVE_ENABLED": "false",
    "RANKED_ENABLED": "true",
    // Approved experimental beta: Free SQLite DO compute; provisional results rating, AI penalty 0.
    "FASTFOLD_ENABLED": "true",
    "AUTH_APP_URL": "https://app.reysonai.com",
    "GOOGLE_REDIRECT_URI": "https://api.reysonai.com/v1/account/google/callback",
    "GOOGLE_CLIENT_ID": "371026940937-n07f7kfnjqdljjrg8phqgidadas875n3.apps.googleusercontent.com",
    "MCP_ENABLED": "true",
    "MCP_ACCESS_MODE": "authenticated_free",
    "MCP_ORIGIN": "https://api.reysonai.com",
    "MCP_ALLOWED_ORIGINS": "https://app.reysonai.com"
  }
}
