{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reysonai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "r2_buckets": [
    {
      "binding": "SOLUTIONS",
      "bucket_name": "reysonai-solutions"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reysonai",
      "database_id": "5f3bd3a1-21c2-4367-9345-011990574b9d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://reysonai.suuu-sh.workers.dev"
  }
}
