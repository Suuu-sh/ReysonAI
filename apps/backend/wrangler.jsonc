{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evionai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "SOLUTIONS",
      "bucket_name": "solveaai-solutions"
    }
  ],
  "d1_databases": [
    {
      "binding": "POSTFLOP_DB",
      "database_name": "evionai-postflop",
      "database_id": "cb6286d2-4bdc-42ed-a9f6-346eaa58d1b3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "*"
  }
}
