{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solveaai-edge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "r2_buckets": [
    {
      "binding": "SOLUTIONS",
      "bucket_name": "solveaai-solutions"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "*"
  }
}
