{
  "name": "@solveaai/preflop-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-site-preview.mjs && vite",
    "dev:codex": "node scripts/build-site-preview.mjs && vite",
    "build": "node scripts/build-site-preview.mjs && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/site/ServiceSite.tsx src/site/content.ts src/main.jsx src/ProductApp.jsx",
    "benchmark": "node scripts/benchmark-compare.mjs",
    "benchmark:record": "node scripts/benchmark-record.mjs",
    "open-ev": "node scripts/open-ev.mjs",
    "exploit-open": "node scripts/exploit-open.mjs",
    "audit:estimates": "node scripts/audit-estimates.mjs",
    "build:estimates": "node scripts/build-estimates.mjs",
    "pipeline": "node scripts/pipeline.mjs",
    "range": "node scripts/range.mjs",
    "raise-ev": "node scripts/raise-ev.mjs",
    "eqr-sensitivity": "node scripts/eqr-sensitivity.mjs",
    "test": "node --test --test-force-exit tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
